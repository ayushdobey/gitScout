# =======================================================
# GitScout: Environment Configuration Template
# =======================================================

# Environment
ENVIRONMENT=development
DEBUG=True

# Security (Generate with: openssl rand -hex 32)
SECRET_KEY=replace_with_a_secure_random_hex_key_for_jwt_signing
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# For local PostgreSQL with pgvector:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/gitscout
# For cloud PostgreSQL (e.g. Neon, Supabase):
# DATABASE_URL=postgresql+psycopg2://username:password@ep-cool-fog-12345.us-east-2.aws.neon.tech/gitscout?sslmode=require
# For local SQLite dev testing (without native pgvector HNSW):
# DATABASE_URL=sqlite:///./gitscout_dev.db

# GitHub API (Optional: increases rate limit from 60 to 5,000 requests/hour)
GITHUB_TOKEN=

# Codebase Ingestion Guardrails
MAX_REPO_SIZE_MB=50
MAX_FILES_COUNT=2500
RATE_LIMIT_PER_MINUTE=30

# Vector Embeddings & RAG
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM Providers (Configure one or more)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Frontend URL for CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration (for frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000


